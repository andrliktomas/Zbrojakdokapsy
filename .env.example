DATABASE_URL="file:./dev.db"
# Veřejná URL aplikace (pro návrat ze Stripe Checkout)
APP_URL="http://localhost:3000"
# Bez STRIPE_SECRET_KEY běží aplikace v režimu "testovací platby" (balíček se aktivuje bez placení).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Jen pro ukázkové nasazení: povolí testovací platby i v produkčním buildu. Na ostrém webu nikdy!
ALLOW_FAKE_PAYMENTS=""

# --- AI vysvětlení chyb („Proč je to špatně?“) ---
# Klíč z https://platform.claude.com (Settings → API keys). Prázdný = funkce vypnutá,
# tlačítko jen ukáže „AI vysvětlení zatím není zapnuté“. Nikdy ho necommitujte.
ANTHROPIC_API_KEY=""
# Model; prázdné = claude-opus-5-5 (výchozí doporučený, $4 / $20 za 1M tokenů vstup / výstup).
# Levnější varianty: claude-sonnet-5-5 ($2 / $10) nebo claude-haiku-5-5 ($0,10 / $0,50).
# Používejte jen aktuální modely (Opus/Sonnet/Haiku 5.5) – volání posílá output_config.effort.
ANTHROPIC_MODEL=""
# Kolik nových AI vysvětlení může jeden uživatel vygenerovat za den (pražský čas).
# Vysvětlení z cache (stejná otázka + stejná špatná odpověď) se nepočítají. Výchozí 30, 0 = jen cache.
AI_EXPLAIN_DAILY_LIMIT=""

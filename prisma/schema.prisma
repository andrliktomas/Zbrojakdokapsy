generator client {
  provider = "prisma-client-js"
}

// Pro vývoj SQLite, v produkci stačí změnit provider na "postgresql" a DATABASE_URL.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  xp             Int       @default(0)
  streak         Int       @default(0)
  bestStreak     Int       @default(0)
  lastActiveDay  String? // YYYY-MM-DD v Europe/Prague

  sessions     Session[]
  purchases    Purchase[]
  attempts     QuestionAttempt[]
  cards        CardProgress[]
  tests        TestResult[]
  achievements Achievement[]
  lessonsRead  LessonRead[]

  // Doporučení (referral) – kód se vygeneruje při prvním zobrazení odkazu.
  referralCode     String?    @unique
  referralsMade    Referral[] @relation("ReferralsMade")
  referralReceived Referral?  @relation("ReferralReceived")

  // Skupiny pro instruktory a střelnice
  groupsTaught    Group[]          @relation("GroupInstructor")
  groupMembership GroupMember[]
  seatOrders      SeatOrder[]
  codesRedeemed   ActivationCode[] @relation("CodeRedeemer")
  redeemAttempts  RedeemAttempt[]
}

model Session {
  id        String   @id // sha256 hash tokenu z cookie
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  planId          String
  amountCzk       Int
  startsAt        DateTime
  endsAt          DateTime
  provider        String // "stripe" | "dev"
  providerRef     String   @unique // Stripe checkout session id
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt])
}

model QuestionAttempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  topic      String
  correct    Boolean
  mode       String // "practice" | "test"
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topic, createdAt])
  @@index([userId, questionId])
}

model CardProgress {
  userId     String
  cardId     String
  topic      String
  box        Int      @default(1) // Leitnerův systém 1–5
  dueAt      DateTime
  reviews    Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId, dueAt])
}

model TestResult {
  id          String   @id @default(cuid())
  userId      String
  score       Int
  total       Int
  passed      Boolean
  permitType  String   @default("obecne") // "obecne" | "rozsirene"
  durationSec Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Achievement {
  userId     String
  code       String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, code])
}

model LessonRead {
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

// --- Skupiny pro instruktory a střelnice (B2B) ---

model Group {
  id           String   @id @default(cuid())
  name         String
  instructorId String
  joinCode     String   @unique // krátký kód pro odkaz /skupina/pripojit/<kód>
  createdAt    DateTime @default(now())
  instructor   User     @relation("GroupInstructor", fields: [instructorId], references: [id], onDelete: Cascade)

  members    GroupMember[]
  seatOrders SeatOrder[]
  codes      ActivationCode[]

  @@index([instructorId])
}

/// Člen skupiny = student, který souhlasil se sdílením pokroku s instruktorem.
model GroupMember {
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())
  consentAt DateTime // okamžik souhlasu se sdílením pokroku
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

/// Nákup balíčku míst (aktivačních kódů) instruktorem. Idempotentní přes providerRef.
model SeatOrder {
  id          String   @id @default(cuid())
  groupId     String
  buyerId     String
  packageId   String
  seats       Int
  planId      String // balíček přístupu, který aktivuje každý kód
  amountCzk   Int
  provider    String // "stripe" | "dev"
  providerRef String   @unique // Stripe checkout session id
  createdAt   DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  buyer       User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  codes ActivationCode[]

  @@index([groupId])
  @@index([buyerId])
}

/// Jednorázový aktivační kód. Uplatnění vytvoří Purchase (provider "code", providerRef "code_<id>").
model ActivationCode {
  id           String    @id @default(cuid())
  code         String    @unique // normalizovaný tvar bez pomlček
  groupId      String
  orderId      String
  planId       String
  createdAt    DateTime  @default(now())
  redeemedAt   DateTime?
  redeemedById String?
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  order        SeatOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  redeemedBy   User?     @relation("CodeRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([groupId, redeemedAt])
  @@index([orderId])
  @@index([redeemedById])
}

/// Pokusy o uplatnění kódu / připojení ke skupině – pro omezení hádání kódů.
model RedeemAttempt {
  id        String   @id @default(cuid())
  userId    String
  kind      String // "code" | "join"
  ipHash    String?
  success   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([ipHash, kind, createdAt])
}

// --- Doporučení (referral) ---

model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String    @unique // každý účet může být doporučen jen jednou (při registraci)
  status      String    @default("pending") // "pending" | "rewarded" | "capped"
  createdAt   DateTime  @default(now())
  qualifiedAt DateTime? // první aktivace přístupu doporučeného
  rewardMonth String? // "YYYY-MM" (Europe/Prague) – pro měsíční limit odměn doporučujícího
  referrer    User      @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred    User      @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId, status, rewardMonth])
}
